import axios from "axios";
import {
  Document,
  D): Promise<PresignedUploadResponse> => {
  console.log("\n📡 [FRONTEND] Requesting presigned upload URL from backend");
  console.log("   Filename:", fileName);
  console.log("   Size:", fileSize, "bytes");
  console.log("   Type:", mimeType);

